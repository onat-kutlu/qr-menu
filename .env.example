# Environment Configuration for QR Menu MVP

# Spring Profile: local, mvp, preprod, prod
SPRING_PROFILE=mvp

# Database Configuration
DB_NAME=qrmenu
DB_USER=postgres
DB_PASSWORD=replace-with-a-local-password
DB_PORT=5432
DB_HOST_PORT=5432

# Redis Configuration
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_HOST_PORT=6379

# Server Configuration
SERVER_PORT=8080
SERVER_HOST_PORT=8080
SERVER_SERVLET_CONTEXT_PATH=/
NGINX_HTTP_PORT=8081
NGINX_HTTPS_PORT=8443

# Application Properties
APP_NAME="QR Menu"
APP_VERSION=0.0.1-MVP

# CORS Configuration (will be used in later modules)
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:8081,http://localhost:5173

# File Storage Path
STORAGE_PATH=/app/storage
STORAGE_MAX_FILE_SIZE_MB=10
STORAGE_PDF_MAX_PAGES=30

# JWT Configuration (Module 2)
JWT_SECRET_KEY=replace-with-a-random-secret-at-least-64-bytes
JWT_EXPIRATION_HOURS=24
JWT_REFRESH_TOKEN_EXPIRATION_DAYS=7

# Email Configuration (Module 2 - MVP uses mock)
EMAIL_PROVIDER=mock
EMAIL_FROM=noreply@qrmenu.local
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USERNAME=user@example.com
SMTP_PASSWORD=replace-with-smtp-password

# Admin Configuration
ADMIN_EMAIL=admin@qrmenu.local
ADMIN_PASSWORD=replace-with-admin-password

# Logging Configuration
LOG_LEVEL=INFO
LOG_STORAGE_PATH=/app/storage/logs
LOG_RETENTION_DAYS=30
APP_LOG_FILE=app.log
ERROR_LOG_FILE=error.log
AUDIT_LOG_FILE=audit.log

# Backup Configuration (Module 12)
BACKUP_DIR=storage/backups/postgres
BACKUP_RETENTION_DAYS=30
DB_HOST=localhost

# Deployment Configuration (Module 12)
DEPLOY_BRANCH=main
APP_DIR=/opt/qr-menu
VPS_HOST=your-vps-host
VPS_USER=deploy
SSH_KEY_PATH=~/.ssh/id_ed25519

# Rate Limiting Configuration (Module 10)
RATE_LIMIT_ENABLED=true
RATE_LIMIT_LOGIN_ATTEMPTS=5
RATE_LIMIT_LOGIN_WINDOW_MINUTES=15

# Analytics Configuration (Module 9)
ANALYTICS_ENABLED=true

# AWS/Cloudflare Configuration (PreProd onwards)
CDN_ENABLED=false
R2_BUCKET=qrmenu-menus
R2_REGION=auto
R2_ACCOUNT_ID=your-account-id
R2_ACCESS_KEY_ID=your-access-key
R2_SECRET_ACCESS_KEY=your-secret-key
